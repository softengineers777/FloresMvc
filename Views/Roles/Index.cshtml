@{
    ViewData["Title"] = "Gestion de Roles";
}

<div class="container-fluid mt-4">
    <h2>Gestion Interactiva de Roles</h2>
    <p class="text-muted">💡 <strong>Instruccion:</strong> Haz doble clic en la celda (Nombre) para editarla directamente al estilo Excel. Los cambios se guardaran automaticamente.</p>
    
    <div class="mb-3">
        <!-- El ID del modal apunta a _Create de roles -->
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createRolModal">
            <i class="bi bi-plus-circle me-1"></i> Crear Nuevo Rol
        </button>
    </div>

    <!-- Contenedor único para la tabla de roles -->
    <div id="roles-table"></div>
</div>

<!-- Vista parcial del modal de roles -->
@await Html.PartialAsync("Create")

@section Scripts {
    <!-- Estilos y JS de Tabulator -->
    <link href="https://unpkg.com/tabulator-tables@5.5.2/dist/css/tabulator_bootstrap5.min.css" rel="stylesheet">
    <script type="text/javascript" src="https://unpkg.com/tabulator-tables@5.5.2/dist/js/tabulator.min.js"></script>
    
    <!-- Scripts específicos para la gestión de roles -->
    <script src="~/js/TablaRoles.js" asp-append-version="true"></script>
    <script src="~/js/commonModal.js" asp-append-version="true"></script>
    <script src="~/js/roles.js" asp-append-version="true"></script>
}