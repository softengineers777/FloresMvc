@model FloresMvc.Models.ActaDescargos
@{
    Layout = null;
    var nombreCargo = ViewBag.NombreCargo as string ?? Model.IdCargo.ToString();
    var nombreArea = ViewBag.NombreArea as string ?? Model.IdArea.ToString();
    var preguntas = Model.Preguntas?.OrderBy(p => p.Orden).ThenBy(p => p.IdPregunta).ToList() ?? new List<FloresMvc.Models.ActaDescargosPreguntas>();
    string FmtDate(DateTime? d) => d.HasValue ? d.Value.ToString("dd/MM/yyyy") : "—";
    string FmtDateTime(DateTime? d) => d.HasValue ? d.Value.ToString("dd/MM/yyyy HH:mm") : "—";
    string SiNo(bool? b) => b == true ? "Sí" : b == false ? "No" : "—";
    var fechaCreacion = Model.fecha_Creacion == default ? "" : Model.fecha_Creacion.ToString("dd/MM/yyyy");
    var ciudadFecha = string.IsNullOrWhiteSpace(Model.Ciudad) ? fechaCreacion : $"{Model.Ciudad}, {fechaCreacion}";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Acta de Descargos N.º @Model.IdActa</title>
    <link rel="stylesheet" href="~/assets/css/acta-descargos-documento.css" asp-append-version="true" />
</head>
<body>
    <div class="toolbar">
        <button type="button" class="btn" onclick="window.print()">Imprimir / Guardar como PDF</button>
        <a class="btn secondary" href="@Url.Action("Details", "ActaDescargos", new { id = Model.IdActa })">Volver al detalle</a>
        <a class="btn secondary" href="@Url.Action("Index", "ActaDescargos")">Listado</a>
    </div>

    <main class="page">
        <table class="header-table">
            <tr>
                <td class="logo-cell">
                    <img src="~/assets/images/logo-conflicto-interes.png" alt="Logo" class="logo" asp-append-version="true" />
                </td>
                <td class="title-cell">
                    <div class="company">MOUNTAIN ROSES SAS</div>
                    <div class="title">ACTA DE DESCARGOS</div>
                </td>
                <td class="meta-cell">
                    <div><strong>Consecutivo</strong> @Model.IdActa</div>
                    <div><strong>Fecha</strong> @(string.IsNullOrWhiteSpace(fechaCreacion) ? "—" : fechaCreacion)</div>
                </td>
            </tr>
        </table>

        <table class="form-table">
            <tr>
                <th class="label">Ciudad y fecha</th>
                <td class="value">@ciudadFecha</td>
                <th class="label">Fecha informe disciplinario</th>
                <td class="value">@FmtDate(Model.FechaInformeDisciplinario)</td>
            </tr>
            <tr>
                <th class="label">Fecha diligencia</th>
                <td class="value">@FmtDateTime(Model.FechaDiligencia)</td>
                <th class="label">Hora inicio / fin</th>
                <td class="value">@(string.IsNullOrWhiteSpace(Model.HoraInicio) ? "—" : Model.HoraInicio) / @(string.IsNullOrWhiteSpace(Model.HoraFin) ? "—" : Model.HoraFin)</td>
            </tr>
        </table>

        <table class="form-table">
            <tr>
                <th class="label">Nombre del trabajador</th>
                <td class="value" colspan="3">@Model.NombreTrabajador</td>
            </tr>
            <tr>
                <th class="label">C.C.</th>
                <td class="value">@Model.CcTrabajador</td>
                <th class="label">Teléfono</th>
                <td class="value">@(string.IsNullOrWhiteSpace(Model.Telefono) ? "—" : Model.Telefono)</td>
            </tr>
            <tr>
                <th class="label">Dirección de residencia</th>
                <td class="value" colspan="3">@(string.IsNullOrWhiteSpace(Model.DireccionResidencia) ? "—" : Model.DireccionResidencia)</td>
            </tr>
            <tr>
                <th class="label">Cargo</th>
                <td class="value">@nombreCargo</td>
                <th class="label">Área / Proceso</th>
                <td class="value">@nombreArea — @Model.Proceso</td>
            </tr>
            <tr>
                <th class="label">Fecha de ingreso</th>
                <td class="value">@FmtDate(Model.FechaIngreso)</td>
                <th class="label">Asistido por testigos</th>
                <td class="value">@SiNo(Model.AsistidoTestigos) @(string.IsNullOrWhiteSpace(Model.NombreTestigo) ? "" : $"— {Model.NombreTestigo}")</td>
            </tr>
        </table>

        <div class="body-box">
            La presente diligencia se lleva a cabo para dar cumplimiento a las normas del C.S.T. y Reglamento Interno de Trabajo sobre verificación de faltas laborales y respetar el derecho constitucional a la defensa y contradicción, con base en el informe disciplinario de fecha <strong>@FmtDate(Model.FechaInformeDisciplinario)</strong>.
        </div>

        <table class="qa-table">
            <thead>
                <tr>
                    <th style="width: 45px;">#</th>
                    <th>Preguntas y respuestas</th>
                </tr>
            </thead>
            <tbody>
            @if (preguntas.Count == 0)
            {
                <tr><td class="center" colspan="2">Sin preguntas registradas.</td></tr>
            }
            else
            {
                foreach (var p in preguntas)
                {
                    <tr>
                        <td class="center">@(p.Orden > 0 ? p.Orden : p.IdPregunta)</td>
                        <td>
                            <div class="q"><strong>P:</strong> @p.Pregunta</div>
                            <div class="a"><strong>R:</strong> @p.Respuesta</div>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>

        <table class="form-table">
            <tr>
                <th class="label section-title" colspan="4">Concepto de Gestión Humana y sanción</th>
            </tr>
            <tr>
                <th class="label">Días de sanción</th>
                <td class="value">@(Model.DiasSancion?.ToString() ?? "—")</td>
                <th class="label">Fecha inicio sanción</th>
                <td class="value">@FmtDate(Model.FechaInicioSancion)</td>
            </tr>
            <tr>
                <th class="label">Concepto</th>
                <td class="value" colspan="3"><div class="pre">@(string.IsNullOrWhiteSpace(Model.ConceptoGestionHumana) ? "—" : Model.ConceptoGestionHumana)</div></td>
            </tr>
        </table>

        <div class="cierre-text">
            Doy fe que la anterior declaración la rendí libremente y soy plenamente consciente de su alcance legal.
        </div>

        <table class="sign-table">
            <tr>
                <td class="sign-col">
                    <div class="sign-space">@Model.CcTrabajador</div>
                    <div class="sign-line"></div>
                    <div class="sign-caption">EL TRABAJADOR<br /><span class="sign-sub">Nombre y C.C.</span></div>
                </td>
                <td class="sign-col">
                    <div class="sign-space">@(string.IsNullOrWhiteSpace(Model.Owner) ? "" : Model.Owner)</div>
                    <div class="sign-line"></div>
                    <div class="sign-caption">POR LA EMPRESA<br /><span class="sign-sub">Dirección de Gestión Humana</span></div>
                </td>
            </tr>
        </table>

        <div class="footer">Generado desde FloresMvc — @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</div>
    </main>
</body>
</html>
