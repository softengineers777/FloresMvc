@model IEnumerable<FloresMvc.Models.Cargo>
@{
    ViewData["Title"] = "Cargos";
    var cargos = Model?.ToList() ?? new List<FloresMvc.Models.Cargo>();
}

<div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="page-title">Cargos</h1>
        <p class="page-subtitle mb-0">Administra los cargos registrados en FloresVida.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        @if (User.HasClaim("permiso", "Cargo.Exportar"))
        {
            <a asp-action="ExportarExcel" class="btn btn-outline-success">
                <i class="bi bi-file-earmark-excel me-1"></i> Descargar Excel
            </a>
        }
        @if (User.HasClaim("permiso", "Cargo.Crear"))
        {
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle me-1"></i> Nuevo Cargo
            </a>
        }
    </div>
</div>

<div class="table-card-custom">
    <div class="table-header-control">
        <div class="table-search-box">
            <i class="bi bi-search table-search-icon"></i>
            <input type="text" id="cargos-search" class="table-search-input" placeholder="Buscar cargo...">
        </div>
        <div class="table-filter-group">
            <span class="badge bg-light text-dark">
                <i class="bi bi-collection me-1"></i> @cargos.Count registro(s)
            </span>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table-custom" id="cargos-table" data-paginate data-page-size="10">
            <thead>
                <tr>
                    <th style="width: 90px;">N.º</th>
                    <th>Nombre del Cargo</th>
                    <th>Fecha de Creación</th>
                    <th>Creado por</th>
                    <th>Última Modificación</th>
                    <th>Fecha de Modificación</th>
                    <th class="text-center" style="width: 140px;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (cargos.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox d-block mb-2" style="font-size: 2rem;"></i>
                            No hay cargos registrados todavía.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var cargo in cargos)
                    {
                        <tr>
                            <td class="table-order-id">@cargo.IdCargo</td>
                            <td class="table-product-name">@cargo.NomCargo</td>
                            <td>@(cargo.fecha_Creacion == default ? "—" : cargo.fecha_Creacion.ToString("dd/MM/yyyy HH:mm"))</td>
                            <td>@(string.IsNullOrWhiteSpace(cargo.Owner) ? "—" : cargo.Owner)</td>
                            <td>@(string.IsNullOrWhiteSpace(cargo.LastModify) ? "—" : cargo.LastModify)</td>
                            <td>@(cargo.LastDate.HasValue ? cargo.LastDate.Value.ToString("dd/MM/yyyy HH:mm") : "—")</td>
                            <td>
                                <div class="d-flex justify-content-center gap-1">
                                    @if (User.HasClaim("permiso", "Cargo.Ver"))
                                    {
                                        <a asp-action="Details" asp-route-id="@cargo.IdCargo" class="table-btn-action" title="Ver detalle">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    }
                                    @if (User.HasClaim("permiso", "Cargo.Editar"))
                                    {
                                        <a asp-action="Edit" asp-route-id="@cargo.IdCargo" class="table-btn-action" title="Editar">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    }
                                    @if (User.HasClaim("permiso", "Cargo.Eliminar"))
                                    {
                                        <a asp-action="Delete" asp-route-id="@cargo.IdCargo" class="table-btn-action delete" title="Eliminar">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/assets/js/table-pagination.js"></script>
}
