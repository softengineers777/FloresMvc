@model IEnumerable<FloresMvc.Models.ConsultaPeps>
@{
    ViewData["Title"] = "Consultas PEPS";
    var items = Model?.ToList() ?? new List<FloresMvc.Models.ConsultaPeps>();
    var usuarios = ViewBag.Usuarios as IDictionary<int, string> ?? new Dictionary<int, string>();
    var cargos = ViewBag.Cargos as IDictionary<int, string> ?? new Dictionary<int, string>();
    var areas = ViewBag.Areas as IDictionary<int, string> ?? new Dictionary<int, string>();
}

<div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="page-title">Consultas PEPS</h1>
        <p class="page-subtitle mb-0">Administra las consultas PEPS registradas.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="ExportarExcel" class="btn btn-outline-success">
            <i class="bi bi-file-earmark-excel me-1"></i> Descargar Excel
        </a>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i> Nueva Consulta
        </a>
    </div>
</div>

<div class="table-card-custom">
    <div class="table-header-control">
        <div class="table-search-box">
            <i class="bi bi-search table-search-icon"></i>
            <input type="text" id="consultapeps-search" class="table-search-input" placeholder="Buscar consulta...">
        </div>
        <div class="table-filter-group">
            <span class="badge bg-light text-dark">
                <i class="bi bi-collection me-1"></i> @items.Count registro(s)
            </span>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table-custom" id="consultapeps-table" data-paginate data-page-size="10">
            <thead>
                <tr>
                    <th style="width: 90px;">N.º</th>
                    <th>Usuario</th>
                    <th>Cédula</th>
                    <th>Cargo</th>
                    <th>Área</th>
                    <th>Es PEP</th>
                    <th>Creado por</th>
                    <th>Fecha registro</th>
                    <th>Modificado por</th>
                    <th>Fecha de modificación</th>
                    <th class="text-center" style="width: 170px;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (items.Count == 0)
                {
                    <tr>
                        <td colspan="11" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox d-block mb-2" style="font-size: 2rem;"></i>
                            No hay consultas PEPS registradas todavía.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in items)
                    {
                        var nomUsuario = usuarios.TryGetValue(item.IdUsuario, out var nu) ? nu : item.IdUsuario.ToString();
                        var nomCargo = cargos.TryGetValue(item.IdCargo, out var nc) ? nc : (item.IdCargo > 0 ? item.IdCargo.ToString() : "—");
                        var nomArea = areas.TryGetValue(item.IdArea, out var na) ? na : (item.IdArea > 0 ? item.IdArea.ToString() : "—");
                        <tr>
                            <td class="table-order-id">@item.IdConsulta</td>
                            <td class="table-product-name">@nomUsuario</td>
                            <td>@(string.IsNullOrWhiteSpace(item.Cedula) ? "—" : item.Cedula)</td>
                            <td>@nomCargo</td>
                            <td>@nomArea</td>
                            <td>@(item.EsPep == true ? "Sí" : item.EsPep == false ? "No" : "—")</td>
                            <td>@(string.IsNullOrWhiteSpace(item.Owner) ? "—" : item.Owner)</td>
                            <td>@(item.DateOwner.HasValue ? item.DateOwner.Value.ToString("dd/MM/yyyy HH:mm") : "—")</td>
                            <td>@(string.IsNullOrWhiteSpace(item.LastModify) ? "—" : item.LastModify)</td>
                            <td>@(item.LastDate.HasValue ? item.LastDate.Value.ToString("dd/MM/yyyy HH:mm") : "—")</td>
                            <td>
                                <div class="d-flex justify-content-center gap-1">
                                    <a asp-action="Details" asp-route-id="@item.IdConsulta" class="table-btn-action" title="Ver detalle">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Documento" asp-route-id="@item.IdConsulta" class="table-btn-action" title="Ver documento / PDF" target="_blank">
                                        <i class="bi bi-file-earmark-pdf"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.IdConsulta" class="table-btn-action" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.IdConsulta" class="table-btn-action delete" title="Eliminar">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/assets/js/table-pagination.js"></script>
}
