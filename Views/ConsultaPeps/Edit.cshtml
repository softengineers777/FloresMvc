@model FloresMvc.Models.ConsultaPeps
@{
    ViewData["Title"] = "Editar Consulta PEPS";
}

<div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="page-title">Editar Consulta PEPS</h1>
        <p class="page-subtitle mb-0">Actualiza la información de la consulta seleccionada.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Volver al listado
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="IdConsulta" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="IdUsuario" class="form-label fw-semibold"></label>
                        <select asp-for="IdUsuario" class="form-select" asp-items="ViewBag.Usuarios">
                            <option value="">-- Seleccione un usuario --</option>
                        </select>
                        <span asp-validation-for="IdUsuario" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Cedula" class="form-label fw-semibold"></label>
                        <input asp-for="Cedula" class="form-control" />
                        <span asp-validation-for="Cedula" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="IdCargo" class="form-label fw-semibold"></label>
                        <select asp-for="IdCargo" class="form-select" asp-items="ViewBag.Cargos">
                            <option value="0">-- Seleccione un cargo --</option>
                        </select>
                        <span asp-validation-for="IdCargo" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="IdArea" class="form-label fw-semibold"></label>
                        <select asp-for="IdArea" class="form-select" asp-items="ViewBag.Areas">
                            <option value="0">-- Seleccione un área --</option>
                        </select>
                        <span asp-validation-for="IdArea" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="EsPep" class="form-label fw-semibold d-block"></label>
                        <div class="d-flex gap-4">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" asp-for="EsPep" id="EsPepSi" value="true" />
                                <label class="form-check-label" for="EsPepSi">Sí</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" asp-for="EsPep" id="EsPepNo" value="false" />
                                <label class="form-check-label" for="EsPepNo">No</label>
                            </div>
                        </div>
                        <span asp-validation-for="EsPep" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Firma" class="form-label fw-semibold"></label>
                        <input type="hidden" asp-for="Firma" id="Firma" />
                        <div class="border rounded bg-white p-2" style="max-width: 520px;">
                            <canvas id="firma-pad" class="w-100" height="180" style="touch-action: none; display: block;"></canvas>
                        </div>
                        <div class="mt-2 d-flex gap-2">
                            <button type="button" class="btn btn-outline-secondary btn-sm" id="firma-clear">
                                <i class="bi bi-eraser me-1"></i> Limpiar firma
                            </button>
                        </div>
                        <div class="form-text">Dibuje una nueva firma para reemplazar la actual, o deje el recuadro como está para conservarla.</div>
                        <span asp-validation-for="Firma" class="text-danger"></span>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label text-muted small mb-1">Creado por</label>
                            <div class="form-control-plaintext">@(string.IsNullOrWhiteSpace(Model.Owner) ? "—" : Model.Owner)</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted small mb-1">Fecha registro</label>
                            <div class="form-control-plaintext">@(Model.DateOwner.HasValue ? Model.DateOwner.Value.ToString("dd/MM/yyyy HH:mm") : "—")</div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save me-1"></i> Guardar Cambios
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/signature_pad@4.1.7/dist/signature_pad.umd.min.js"></script>
    <script>
        (function () {
            var canvas = document.getElementById('firma-pad');
            var input = document.getElementById('Firma');
            var clearBtn = document.getElementById('firma-clear');
            if (!canvas || !input || typeof SignaturePad === 'undefined') return;

            function resizeCanvas() {
                var ratio = Math.max(window.devicePixelRatio || 1, 1);
                var data = signaturePad && !signaturePad.isEmpty() ? signaturePad.toData() : null;
                canvas.width = canvas.offsetWidth * ratio;
                canvas.height = 180 * ratio;
                canvas.getContext('2d').scale(ratio, ratio);
                if (signaturePad) {
                    signaturePad.clear();
                    if (data) signaturePad.fromData(data);
                }
            }

            var signaturePad = new SignaturePad(canvas, {
                backgroundColor: 'rgb(255, 255, 255)',
                penColor: 'rgb(20, 20, 20)'
            });

            window.addEventListener('resize', resizeCanvas);
            resizeCanvas();

            var existing = input.value || '';
            if (existing.indexOf('data:image') === 0) {
                try { signaturePad.fromDataURL(existing); } catch (e) { }
            }

            if (clearBtn) {
                clearBtn.addEventListener('click', function () {
                    signaturePad.clear();
                    input.value = '';
                });
            }

            var form = canvas.closest('form');
            if (form) {
                form.addEventListener('submit', function () {
                    if (!signaturePad.isEmpty()) {
                        input.value = signaturePad.toDataURL('image/png');
                    } else if (existing.indexOf('data:image') !== 0) {
                        input.value = existing;
                    }
                });
            }
        })();
    </script>
}
