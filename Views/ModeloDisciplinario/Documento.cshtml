@model FloresMvc.Models.ModeloDisciplinario
@{
    Layout = null;
    var nombreArea = ViewBag.NombreArea as string ?? Model.IdArea.ToString();
    var nombreCargo = ViewBag.NombreCargo as string ?? Model.cargo.ToString();
    var fecha = Model.fecha_creacion == default ? "" : Model.fecha_creacion.ToString("dd/MM/yyyy");
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Modelo Disciplinario N.º @Model.IdModelo</title>
    <link rel="stylesheet" href="~/assets/css/modelo-disciplinario-documento.css" asp-append-version="true" />
</head>
<body>
    <div class="toolbar">
        <button type="button" class="btn" onclick="window.print()">Imprimir / Guardar como PDF</button>
        <a class="btn secondary" href="@Url.Action("Details", "ModeloDisciplinario", new { id = Model.IdModelo })">Volver al detalle</a>
        <a class="btn secondary" href="@Url.Action("Index", "ModeloDisciplinario")">Listado</a>
    </div>

    <main class="page">
        <table class="header-table">
            <tr>
                <td class="logo-cell">
                    <img src="~/assets/images/logo-conflicto-interes.png" alt="Logo" class="logo" asp-append-version="true" />
                </td>
                <td class="title-cell">
                    <div class="company">MOUNTAIN ROSES SAS</div>
                    <div class="title">MODELO INFORME DISCIPLINARIO</div>
                </td>
                <td class="meta-cell">
                    <div><strong>Consecutivo</strong> @Model.IdModelo</div>
                    <div><strong>Fecha</strong> @(string.IsNullOrWhiteSpace(fecha) ? "—" : fecha)</div>
                </td>
            </tr>
        </table>

        <table class="form-table">
            <tr>
                <th class="label">Ciudad y fecha</th>
                <td class="value" colspan="3">@fecha</td>
            </tr>
            <tr>
                <th class="label">Para</th>
                <td class="value" colspan="3">@Model.para</td>
            </tr>
            <tr>
                <th class="label">Asunto</th>
                <td class="value" colspan="3">@Model.asunto</td>
            </tr>
            <tr>
                <th class="label">Nombre del trabajador</th>
                <td class="value" colspan="3">@Model.NomTrabajador</td>
            </tr>
            <tr>
                <th class="label">Cargo</th>
                <td class="value">@nombreCargo</td>
                <th class="label">Área / Proceso</th>
                <td class="value">@nombreArea — @Model.Proceso</td>
            </tr>
        </table>

        <table class="form-table situacion-table">
            <tr>
                <th class="label section-title">Situación</th>
            </tr>
            <tr>
                <td class="value situacion-cell">
                    <div class="situacion-note">(Describa la situación de forma clara y precisa: cuándo, quién, qué, dónde, testigos, anexando los soportes según corresponda)</div>
                    <div class="situacion-text">@(string.IsNullOrWhiteSpace(Model.Situacion) ? "—" : Model.Situacion)</div>
                </td>
            </tr>
        </table>

        <div class="signature-block">
            <div class="signature-box">
                <div class="atentamente">Atentamente,</div>
                <div class="sign-area">
                    @if (!string.IsNullOrWhiteSpace(Model.Firma) && Model.Firma.StartsWith("data:image"))
                    {
                        <img src="@Model.Firma" alt="Firma" class="firma-img" />
                    }
                    else if (!string.IsNullOrWhiteSpace(Model.Firma))
                    {
                        <div class="firma-text">@Model.Firma</div>
                    }
                </div>
                <div class="sign-line"></div>
                <div class="sign-caption">JEFE DIRECTO<br /><span class="sign-sub">Nombre y firma</span></div>
                <div class="sign-owner">@(string.IsNullOrWhiteSpace(Model.Owner) ? "" : Model.Owner)</div>
            </div>
        </div>

        <div class="footer">Generado desde FloresMvc — @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</div>
    </main>
</body>
</html>
