@model FloresMvc.Models.ModeloDisciplinario
@{
    Layout = null;
    var nombreArea = ViewBag.NombreArea as string ?? Model.IdArea.ToString();
    var nombreCargo = ViewBag.NombreCargo as string ?? Model.cargo.ToString();
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Modelo Disciplinario N.º @Model.IdModelo</title>
    <link rel="stylesheet" href="~/assets/css/modelo-disciplinario-documento.css" asp-append-version="true" />
</head>
<body>
    <div class="toolbar">
        <button type="button" class="btn" onclick="window.print()">Imprimir / Guardar como PDF</button>
        <a class="btn secondary" href="@Url.Action("Details", "ModeloDisciplinario", new { id = Model.IdModelo })">Volver al detalle</a>
        <a class="btn secondary" href="@Url.Action("Index", "ModeloDisciplinario")">Listado</a>
    </div>

    <main class="page">
        <h1>Modelo Disciplinario</h1>
        <p class="subtitle">Gestión Humana — Registro N.º @Model.IdModelo</p>

        <div class="meta">
            <div><span class="label">Para</span><div class="value">@Model.para</div></div>
            <div><span class="label">Fecha de creación</span><div class="value">@(Model.fecha_creacion == default ? "—" : Model.fecha_creacion.ToString("dd/MM/yyyy HH:mm"))</div></div>
        </div>

        <section class="box">
            <h2>Información general</h2>
            <div class="grid">
                <div class="field full">
                    <span class="label">Asunto</span>
                    <div class="value">@Model.asunto</div>
                </div>
                <div class="field full">
                    <span class="label">Nombre del trabajador</span>
                    <div class="value">@Model.NomTrabajador</div>
                </div>
                <div class="field">
                    <span class="label">Área</span>
                    <div class="value">@nombreArea</div>
                </div>
                <div class="field">
                    <span class="label">Cargo</span>
                    <div class="value">@nombreCargo</div>
                </div>
                <div class="field full">
                    <span class="label">Proceso</span>
                    <div class="value">@Model.Proceso</div>
                </div>
            </div>
        </section>

        <section class="box">
            <h2>Situación</h2>
            <p class="body-text">@(string.IsNullOrWhiteSpace(Model.Situacion) ? "—" : Model.Situacion)</p>
        </section>

        <div class="signs">
            <div class="sign">
                <div class="sign-mark">@(string.IsNullOrWhiteSpace(Model.Owner) ? "" : Model.Owner)</div>
                <div class="sign-line"></div>
                <div class="sign-caption">Firma responsable</div>
            </div>
            <div class="sign">
                <div class="sign-mark">
                    @if (!string.IsNullOrWhiteSpace(Model.Firma) && Model.Firma.StartsWith("data:image"))
                    {
                        <img src="@Model.Firma" alt="Firma" />
                    }
                    else if (!string.IsNullOrWhiteSpace(Model.Firma))
                    {
                        @Model.Firma
                    }
                </div>
                <div class="sign-line"></div>
                <div class="sign-caption">Firma<br /><span class="sign-role">@nombreCargo</span></div>
            </div>
        </div>

        <div class="footer">Generado desde FloresMvc — @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</div>
    </main>
</body>
</html>
