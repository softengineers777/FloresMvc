@model FloresMvc.Models.ModeloDisciplinario
@{
    ViewData["Title"] = "Detalle del Modelo Disciplinario";
    var nombreArea = ViewBag.NombreArea as string;
    var nombreCargo = ViewBag.NombreCargo as string;
}

<div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="page-title">Detalle del Modelo Disciplinario</h1>
        <p class="page-subtitle mb-0">Información completa del registro seleccionado.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Volver al listado
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-10 col-xl-9">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent border-0 pt-3 px-4">
                <h5 class="mb-0">
                    <i class="bi bi-journal-check text-primary me-1"></i>
                    @Model.NomTrabajador — @Model.asunto
                </h5>
            </div>
            <div class="card-body px-4 pb-4">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted">Consecutivo</dt>
                    <dd class="col-sm-8">@Model.IdModelo</dd>

                    <dt class="col-sm-4 text-muted">Área</dt>
                    <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(nombreArea) ? Model.IdArea.ToString() : nombreArea)</dd>

                    <dt class="col-sm-4 text-muted">Cargo</dt>
                    <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(nombreCargo) ? Model.cargo.ToString() : nombreCargo)</dd>

                    <dt class="col-sm-4 text-muted">Nombre del trabajador</dt>
                    <dd class="col-sm-8">@Model.NomTrabajador</dd>

                    <dt class="col-sm-4 text-muted">Para</dt>
                    <dd class="col-sm-8">@Model.para</dd>

                    <dt class="col-sm-4 text-muted">Asunto</dt>
                    <dd class="col-sm-8">@Model.asunto</dd>

                    <dt class="col-sm-4 text-muted">Proceso</dt>
                    <dd class="col-sm-8">@Model.Proceso</dd>

                    <dt class="col-sm-4 text-muted">Firma</dt>
                    <dd class="col-sm-8">
                        @if (!string.IsNullOrWhiteSpace(Model.Firma) && Model.Firma.StartsWith("data:image"))
                        {
                            <img src="@Model.Firma" alt="Firma" class="border rounded bg-white p-1" style="max-width: 420px; max-height: 180px;" />
                        }
                        else
                        {
                            @Model.Firma
                        }
                    </dd>

                    <dt class="col-sm-4 text-muted">Situación</dt>
                    <dd class="col-sm-8" style="white-space: pre-wrap;">@Model.Situacion</dd>
                </dl>

                <hr class="my-4" />
                <h6 class="text-muted mb-3"><i class="bi bi-clock-history me-1"></i> Auditoría</h6>
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted">Fecha de creación</dt>
                    <dd class="col-sm-8">@(Model.fecha_creacion == default ? "—" : Model.fecha_creacion.ToString("dd/MM/yyyy HH:mm"))</dd>

                    <dt class="col-sm-4 text-muted">Creado por</dt>
                    <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Owner) ? "—" : Model.Owner)</dd>

                    <dt class="col-sm-4 text-muted">Última modificación</dt>
                    <dd class="col-sm-8">@(Model.LastDate.HasValue ? Model.LastDate.Value.ToString("dd/MM/yyyy HH:mm") : "—")</dd>

                    <dt class="col-sm-4 text-muted">Modificado por</dt>
                    <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.LastModify) ? "—" : Model.LastModify)</dd>
                </dl>

                <hr class="my-4" />

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
                    <a asp-action="Edit" asp-route-id="@Model.IdModelo" class="btn btn-primary">
                        <i class="bi bi-pencil me-1"></i> Editar
                    </a>
                    <a asp-action="Delete" asp-route-id="@Model.IdModelo" class="btn btn-outline-danger">
                        <i class="bi bi-trash me-1"></i> Eliminar
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
