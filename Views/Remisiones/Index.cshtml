@{
    ViewData["Title"] = "Remisiones";
}

<div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="page-title">Remisiones</h1>
        <p class="page-subtitle mb-0">Control de ingreso y salida de insumos.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="ExportarExcel" class="btn btn-outline-success">
            <i class="bi bi-file-earmark-excel me-1"></i> Descargar Excel
        </a>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i> Nueva Remisión
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-1"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<div class="table-card-custom">
    <div class="table-header-control">
        <div class="table-search-box">
            <i class="bi bi-search table-search-icon"></i>
            <input type="text" id="remisiones-search" class="table-search-input" placeholder="Buscar remisión...">
        </div>
        <div class="table-filter-group">
            <span class="badge bg-light text-dark">
                <i class="bi bi-collection me-1"></i> <span id="remisiones-count">0</span> registro(s)
            </span>
        </div>
    </div>

    <!-- Tabulator se encarga de la tabla, la búsqueda y la paginación. -->
    <div id="remisiones-table"></div>
</div>

@section Scripts {
    <link href="https://unpkg.com/tabulator-tables@5.5.2/dist/css/tabulator_bootstrap5.min.css" rel="stylesheet">
    <script type="text/javascript" src="https://unpkg.com/tabulator-tables@5.5.2/dist/js/tabulator.min.js"></script>

    <script src="~/js/TablaRemisiones.js" asp-append-version="true"></script>
}
