@model IEnumerable<FloresMvc.Models.Categorias>
@{
    ViewData["Title"] = "Categorías";
    var categorias = Model?.ToList() ?? new List<FloresMvc.Models.Categorias>();
}

<div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="page-title">Categorías</h1>
        <p class="page-subtitle mb-0">Administra las categorías registradas en FloresVida.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="ExportarExcel" class="btn btn-outline-success">
            <i class="bi bi-file-earmark-excel me-1"></i> Descargar Excel
        </a>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i> Nueva Categoría
        </a>
    </div>
</div>

<div class="table-card-custom">
    <div class="table-header-control">
        <div class="table-search-box">
            <i class="bi bi-search table-search-icon"></i>
            <input type="text" id="categorias-search" class="table-search-input" placeholder="Buscar categoría...">
        </div>
        <div class="table-filter-group">
            <span class="badge bg-light text-dark">
                <i class="bi bi-collection me-1"></i> @categorias.Count registro(s)
            </span>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table-custom" id="categorias-table" data-paginate data-page-size="10">
            <thead>
                <tr>
                    <th style="width: 90px;">N.º</th>
                    <th>Nombre de la Categoría</th>
                    <th>Fecha de Creación</th>
                    <th>Creado por</th>
                    <th>Última Modificación</th>
                    <th>Fecha de Modificación</th>
                    <th class="text-center" style="width: 140px;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (categorias.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox d-block mb-2" style="font-size: 2rem;"></i>
                            No hay categorías registradas todavía.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var categoria in categorias)
                    {
                        <tr>
                            <td class="table-order-id">@categoria.IdCategoria</td>
                            <td class="table-product-name">@categoria.Nomcategoria</td>
                            <td>@(categoria.fecha_Creacion == default ? "—" : categoria.fecha_Creacion.ToString("dd/MM/yyyy HH:mm"))</td>
                            <td>@(string.IsNullOrWhiteSpace(categoria.Owner) ? "—" : categoria.Owner)</td>
                            <td>@(string.IsNullOrWhiteSpace(categoria.LastModify) ? "—" : categoria.LastModify)</td>
                            <td>@(categoria.LastDate.HasValue ? categoria.LastDate.Value.ToString("dd/MM/yyyy HH:mm") : "—")</td>
                            <td>
                                <div class="d-flex justify-content-center gap-1">
                                    <a asp-action="Details" asp-route-id="@categoria.IdCategoria" class="table-btn-action" title="Ver detalle">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@categoria.IdCategoria" class="table-btn-action" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@categoria.IdCategoria" class="table-btn-action delete" title="Eliminar">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/assets/js/table-pagination.js"></script>
}
