@model FloresMvc.Models.DeclaracionConflictoInteresViewModel
@{
    ViewData["Title"] = "Nueva Declaración de Conflicto de Interés";
}

<div class="page-header mb-4">
    <h1 class="page-title">Nueva Declaración de Conflicto de Interés</h1>
    <p class="page-subtitle mb-0">Diligencie la información y marque las situaciones que apliquen.</p>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <partial name="_FormFields" model="Model" />
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i> Guardar</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
