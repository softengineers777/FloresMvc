@model FloresMvc.Models.DeclaracionConflictoInteres
@{
    ViewData["Title"] = "Detalle de Declaración de Conflicto de Interés";
    var nombreUsuario = Model.Usuario != null ? $"{Model.Usuario.Nombre} {Model.Usuario.Apellido}".Trim() : Model.IdUsuario.ToString();
    var respuestas = Model.Preguntas?.OrderBy(p => p.Pregunta?.IdPregunta ?? p.IdPregunta).ToList() ?? new List<FloresMvc.Models.DeclaracionConflictoInteresPreguntas>();
}

<div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="page-title">Detalle de Declaración de Conflicto de Interés</h1>
        <p class="page-subtitle mb-0">Consecutivo #@Model.IdDeclaracion</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Documento" asp-route-id="@Model.IdDeclaracion" class="btn btn-outline-dark" target="_blank"><i class="bi bi-file-earmark-pdf"></i> Documento / PDF</a>
        <a asp-action="Edit" asp-route-id="@Model.IdDeclaracion" class="btn btn-primary"><i class="bi bi-pencil"></i> Editar</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4"><strong>Usuario:</strong><br />@nombreUsuario</div>
            <div class="col-md-4"><strong>Documento:</strong><br />@(Model.TipoDoc ?? "CC") @Model.NumeroDocumento</div>
            <div class="col-md-4"><strong>Fecha declaración:</strong><br />@Model.FechaDeclaracion.ToString("dd/MM/yyyy")</div>
            <div class="col-md-4"><strong>Cargo:</strong><br />@(Model.Cargo?.NomCargo ?? "—")</div>
            <div class="col-md-4"><strong>Área:</strong><br />@(Model.Area?.NomArea ?? "—")</div>
            <div class="col-md-4"><strong>Registrado por:</strong><br />@(Model.Owner ?? "—")</div>
        </div>
        <hr />
        <h5>Información de familiar (si aplica)</h5>
        <div class="row g-3">
            <div class="col-md-4"><strong>Nombre:</strong><br />@(Model.NombreFamiliar ?? "—")</div>
            <div class="col-md-4"><strong>Cargo:</strong><br />@(Model.CargoFamiliar ?? "—")</div>
            <div class="col-md-4"><strong>Área:</strong><br />@(Model.AreaFamiliar ?? "—")</div>
            <div class="col-12"><strong>Observaciones:</strong><br />@(string.IsNullOrWhiteSpace(Model.Observaciones) ? "—" : Model.Observaciones)</div>
            <div class="col-12">
                <strong>Firma:</strong><br />
                @if (!string.IsNullOrWhiteSpace(Model.Firma))
                {
                    <img src="@Model.Firma" alt="Firma" style="max-width: 320px; max-height: 140px; border: 1px solid #dee2e6; border-radius: 4px; background: #fff;" />
                }
                else
                {
                    <span>—</span>
                }
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header"><strong>Respuestas</strong></div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped mb-0">
                <thead>
                    <tr>
                        <th style="width: 100px;">Aplica</th>
                        <th style="width: 220px;">Código</th>
                        <th>Descripción</th>
                    </tr>
                </thead>
                <tbody>
                @if (respuestas.Count == 0)
                {
                    <tr><td colspan="3" class="text-center text-muted py-4">Sin respuestas registradas.</td></tr>
                }
                else
                {
                    foreach (var r in respuestas)
                    {
                        <tr>
                            <td>
                                @if (r.Aplica)
                                {
                                    <span class="badge bg-danger">Sí</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">No</span>
                                }
                            </td>
                            <td><strong>@(r.Pregunta?.Codigo ?? r.IdPregunta.ToString())</strong></td>
                            <td>@(r.Pregunta?.Descripcion ?? "")</td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
