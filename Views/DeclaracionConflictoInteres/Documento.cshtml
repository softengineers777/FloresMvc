@model FloresMvc.Models.DeclaracionConflictoInteres
@{
    Layout = null;
    var nombreUsuario = Model.Usuario != null ? $"{Model.Usuario.Nombre} {Model.Usuario.Apellido}".Trim() : Model.IdUsuario.ToString();
    var respuestas = Model.Preguntas?
        .OrderBy(p => p.Pregunta?.IdPregunta ?? p.IdPregunta)
        .ToList() ?? new List<FloresMvc.Models.DeclaracionConflictoInteresPreguntas>();

    string Marca(int index)
    {
        if (index < 0 || index >= respuestas.Count) return "";
        return respuestas[index].Aplica ? "X" : "";
    }

    var empresa = "MOUNTAIN ROSES SAS";
    var area = Model.Area?.NomArea ?? "—";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Declaración de Conflicto de Interés N.º @Model.IdDeclaracion</title>
    <link rel="stylesheet" href="~/assets/css/declaracion-conflicto-interes-documento.css" asp-append-version="true" />
</head>
<body>
    <div class="toolbar">
        <button type="button" class="btn" onclick="window.print()">Imprimir / Guardar como PDF</button>
        <a class="btn secondary" href="@Url.Action("Details", "DeclaracionConflictoInteres", new { id = Model.IdDeclaracion })">Volver al detalle</a>
        <a class="btn secondary" href="@Url.Action("Index", "DeclaracionConflictoInteres")">Listado</a>
    </div>

    <main class="page">
        <table class="header-table">
            <tr>
                <td class="logo-cell">
                    <img src="~/assets/images/logo-conflicto-interes.png" alt="Logo" class="logo" asp-append-version="true" />
                </td>
                <td class="title-cell">
                    <div class="company">@empresa</div>
                    <div class="title">ACTUALIZACIÓN ANUAL DE DECLARACIÓN CONFLICTO DE INTERÉS</div>
                </td>
                <td class="meta-cell">
                    <div><strong>Versión</strong> 2</div>
                    <div><strong>Fecha</strong> @Model.FechaDeclaracion.ToString("dd/MM/yyyy")</div>
                    <div><strong>Página</strong> 1 de 1</div>
                </td>
            </tr>
        </table>

        <table class="info-table">
            <tr>
                <th>EMPRESA</th>
                <td>@empresa</td>
                <th>FECHA DE CONSULTA</th>
                <td>@Model.FechaDeclaracion.ToString("dd/MM/yyyy")</td>
                <th>ÁREA</th>
                <td>@area</td>
            </tr>
        </table>

        <div class="legal-text">
            Con el fin de dar cumplimiento a lo definido en el Código de Ética y Conducta de @empresa, mediante esta declaración se consigna la información relacionada con cualquier situación en la cual los intereses personales de los empleados, proveedores y demás contrapartes entren en conflicto real, potencial o aparente con los intereses de la empresa, que pueda restar independencia, equidad u objetividad en su actuación.
            Manifiesto mi voluntad de declarar cualquier acción o actividad que esté en contravía de cualquier lineamiento de ética y transparencia enmarcado en el Código de Ética y Conducta o en el Programa de Transparencia y Ética Empresarial, suscribiendo el presente documento.
        </div>

        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th rowspan="2">NOMBRE COLABORADOR</th>
                        <th rowspan="2">TIPO DOC</th>
                        <th rowspan="2">NÚMERO DE DOCUMENTO</th>
                        <th rowspan="2">CARGO EMPRESA</th>
                        <th colspan="7">SITUACIONES DE POSIBLE CONFLICTO DE INTERÉS (Marcar con X)</th>
                        <th colspan="3">EN CASO DE PRESENTARSE CONFLICTO DE INTERÉS</th>
                        <th rowspan="2">FIRMA DEL TRABAJADOR</th>
                    </tr>
                    <tr>
                        <th class="q">Relación laboral directa o indirecta con una contraparte de la empresa</th>
                        <th class="q">Relación o vínculo de consanguinidad o afinidad con una contraparte de la empresa</th>
                        <th class="q">Relación o vínculo de consanguinidad o afinidad con un colaborador de la empresa</th>
                        <th class="q">Participación en transacciones, activos o inversiones con una contraparte de la empresa</th>
                        <th class="q">Participación en procesos de selección o contratación de contrapartes con vínculos de consanguinidad y afinidad</th>
                        <th class="q">Manejo de obsequios, regalos o atenciones que se puedan otorgar o recibir con terceros relacionados con la empresa</th>
                        <th class="q">En caso de no presentar ninguna situación que pueda generar conflicto de interés, marcar esta casilla</th>
                        <th>Nombre del familiar (Conflicto de Interés)</th>
                        <th>Cargo del familiar (Conflicto de Interés)</th>
                        <th>Área del familiar (Conflicto de Interés)</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="left">@nombreUsuario</td>
                        <td class="center">@(string.IsNullOrWhiteSpace(Model.TipoDoc) ? "CC" : Model.TipoDoc)</td>
                        <td class="center">@Model.NumeroDocumento</td>
                        <td class="center">@(Model.Cargo?.NomCargo ?? "—")</td>
                        <td class="mark">@Marca(0)</td>
                        <td class="mark">@Marca(1)</td>
                        <td class="mark">@Marca(2)</td>
                        <td class="mark">@Marca(3)</td>
                        <td class="mark">@Marca(4)</td>
                        <td class="mark">@Marca(5)</td>
                        <td class="mark">@Marca(6)</td>
                        <td class="left">@(string.IsNullOrWhiteSpace(Model.NombreFamiliar) ? "" : Model.NombreFamiliar)</td>
                        <td class="left">@(string.IsNullOrWhiteSpace(Model.CargoFamiliar) ? "" : Model.CargoFamiliar)</td>
                        <td class="left">@(string.IsNullOrWhiteSpace(Model.AreaFamiliar) ? "" : Model.AreaFamiliar)</td>
                        <td class="firma-cell">
                            @if (!string.IsNullOrWhiteSpace(Model.Firma))
                            {
                                <img src="@Model.Firma" alt="Firma" class="firma-img" />
                            }
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Observaciones))
        {
            <div class="observaciones"><strong>Observaciones:</strong> @Model.Observaciones</div>
        }

        <div class="footer">Generado desde FloresMvc — @DateTime.Now.ToString("dd/MM/yyyy HH:mm") — Registro N.º @Model.IdDeclaracion</div>
    </main>
</body>
</html>
