@model FloresMvc.Models.DeclaracionConflictoInteres
@{
    Layout = null;
    var nombreUsuario = Model.Usuario != null ? $"{Model.Usuario.Nombre} {Model.Usuario.Apellido}".Trim() : Model.IdUsuario.ToString();
    var respuestas = Model.Preguntas?
        .OrderBy(p => p.Pregunta?.IdPregunta ?? p.IdPregunta)
        .ToList() ?? new List<FloresMvc.Models.DeclaracionConflictoInteresPreguntas>();
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Declaración de Conflicto de Interés N.º @Model.IdDeclaracion</title>
    <link rel="stylesheet" href="~/assets/css/declaracion-conflicto-interes-documento.css" asp-append-version="true" />
</head>
<body>
    <div class="toolbar">
        <button type="button" class="btn" onclick="window.print()">Imprimir / Guardar como PDF</button>
        <a class="btn secondary" href="@Url.Action("Details", "DeclaracionConflictoInteres", new { id = Model.IdDeclaracion })">Volver al detalle</a>
        <a class="btn secondary" href="@Url.Action("Index", "DeclaracionConflictoInteres")">Listado</a>
    </div>

    <main class="page">
        <h1>Declaración de Conflicto de Interés</h1>
        <p class="subtitle">Registro N.º @Model.IdDeclaracion</p>

        <div class="meta">
            <div><span class="label">Consecutivo</span><div class="value">@Model.IdDeclaracion</div></div>
            <div><span class="label">Fecha de declaración</span><div class="value">@Model.FechaDeclaracion.ToString("dd/MM/yyyy")</div></div>
        </div>

        <section class="box">
            <h2>Datos del declarante</h2>
            <div class="grid">
                <div class="field full">
                    <span class="label">Usuario</span>
                    <div class="value">@nombreUsuario</div>
                </div>
                <div class="field">
                    <span class="label">Tipo de documento</span>
                    <div class="value">@(string.IsNullOrWhiteSpace(Model.TipoDoc) ? "CC" : Model.TipoDoc)</div>
                </div>
                <div class="field">
                    <span class="label">Número de documento</span>
                    <div class="value">@Model.NumeroDocumento</div>
                </div>
                <div class="field">
                    <span class="label">Cargo</span>
                    <div class="value">@(Model.Cargo?.NomCargo ?? "—")</div>
                </div>
                <div class="field">
                    <span class="label">Área</span>
                    <div class="value">@(Model.Area?.NomArea ?? "—")</div>
                </div>
            </div>
        </section>

        <section class="box">
            <h2>Información de familiar (si aplica)</h2>
            <div class="grid">
                <div class="field">
                    <span class="label">Nombre del familiar</span>
                    <div class="value">@(string.IsNullOrWhiteSpace(Model.NombreFamiliar) ? "—" : Model.NombreFamiliar)</div>
                </div>
                <div class="field">
                    <span class="label">Cargo del familiar</span>
                    <div class="value">@(string.IsNullOrWhiteSpace(Model.CargoFamiliar) ? "—" : Model.CargoFamiliar)</div>
                </div>
                <div class="field">
                    <span class="label">Área del familiar</span>
                    <div class="value">@(string.IsNullOrWhiteSpace(Model.AreaFamiliar) ? "—" : Model.AreaFamiliar)</div>
                </div>
                <div class="field full">
                    <span class="label">Observaciones</span>
                    <div class="value">@(string.IsNullOrWhiteSpace(Model.Observaciones) ? "—" : Model.Observaciones)</div>
                </div>
            </div>
        </section>

        <section class="box">
            <h2>Situaciones de posible conflicto de interés</h2>
            <table>
                <thead>
                    <tr>
                        <th style="width: 80px;" class="center">Aplica</th>
                        <th style="width: 180px;">Código</th>
                        <th>Descripción</th>
                    </tr>
                </thead>
                <tbody>
                @if (respuestas.Count == 0)
                {
                    <tr>
                        <td colspan="3" class="center">Sin respuestas registradas.</td>
                    </tr>
                }
                else
                {
                    foreach (var r in respuestas)
                    {
                        <tr>
                            <td class="center @(r.Aplica ? "badge-si" : "badge-no")">@(r.Aplica ? "Sí" : "No")</td>
                            <td><strong>@(r.Pregunta?.Codigo ?? r.IdPregunta.ToString())</strong></td>
                            <td>@(r.Pregunta?.Descripcion ?? "")</td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </section>

        <section class="box">
            <h2>Auditoría</h2>
            <div class="grid">
                <div class="field">
                    <span class="label">Creado por</span>
                    <div class="value">@(string.IsNullOrWhiteSpace(Model.Owner) ? "—" : Model.Owner)</div>
                </div>
                <div class="field">
                    <span class="label">Fecha registro</span>
                    <div class="value">@Model.DateOwner.ToString("dd/MM/yyyy HH:mm")</div>
                </div>
                <div class="field">
                    <span class="label">Modificado por</span>
                    <div class="value">@(string.IsNullOrWhiteSpace(Model.LastModify) ? "—" : Model.LastModify)</div>
                </div>
                <div class="field">
                    <span class="label">Última modificación</span>
                    <div class="value">@(Model.LastDate.HasValue ? Model.LastDate.Value.ToString("dd/MM/yyyy HH:mm") : "—")</div>
                </div>
            </div>
        </section>

        <div class="footer">Generado desde FloresMvc — @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</div>
    </main>
</body>
</html>
