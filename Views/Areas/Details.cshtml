@model FloresMvc.Models.Areas
@{
    ViewData["Title"] = "Detalle del Área";
}

<div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="page-title">Detalle del Área</h1>
        <p class="page-subtitle mb-0">Información completa del área seleccionada.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Volver al listado
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent border-0 pt-3 px-4">
                <h5 class="mb-0">
                    <i class="bi bi-geo-alt-fill text-success me-1"></i>
                    @Model.NomArea
                </h5>
            </div>
            <div class="card-body px-4 pb-4">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted">Consecutivo</dt>
                    <dd class="col-sm-8">@Model.IdArea</dd>

                    <dt class="col-sm-4 text-muted">Nombre del área</dt>
                    <dd class="col-sm-8">@Model.NomArea</dd>

                    <dt class="col-sm-4 text-muted">Fecha de creación</dt>
                    <dd class="col-sm-8">
                        @(Model.fecha_Creacion == default ? "—" : Model.fecha_Creacion.ToString("dd/MM/yyyy HH:mm"))
                    </dd>

                    <dt class="col-sm-4 text-muted">Creado por</dt>
                    <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Owner) ? "—" : Model.Owner)</dd>

                    <dt class="col-sm-4 text-muted">Última modificación</dt>
                    <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.LastModify) ? "—" : Model.LastModify)</dd>

                    <dt class="col-sm-4 text-muted">Fecha de modificación</dt>
                    <dd class="col-sm-8">
                        @(Model.LastDate.HasValue ? Model.LastDate.Value.ToString("dd/MM/yyyy HH:mm") : "—")
                    </dd>
                </dl>

                <hr class="my-4" />

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
                    <a asp-action="Edit" asp-route-id="@Model.IdArea" class="btn btn-primary">
                        <i class="bi bi-pencil me-1"></i> Editar
                    </a>
                    <a asp-action="Delete" asp-route-id="@Model.IdArea" class="btn btn-outline-danger">
                        <i class="bi bi-trash me-1"></i> Eliminar
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
