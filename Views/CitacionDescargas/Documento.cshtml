@model FloresMvc.Models.CitacionDescargos
@{
    Layout = null;
    var nombreCargo = ViewBag.NombreCargo as string ?? Model.IdCargo.ToString();
    var nombreArea = ViewBag.NombreArea as string ?? Model.IdArea.ToString();
    var fechaDiligencia = Model.fecha_Diligencia?.ToString("dd 'de' MMMM 'de' yyyy");
    var horaDiligencia = Model.HoraDiligencia?.ToString("HH:mm");
    var fechaHechos = Model.FechaHechos?.ToString("dd 'de' MMMM 'de' yyyy");
    var fechaCreacion = Model.fecha_Creacion == default ? "" : Model.fecha_Creacion.ToString("dd/MM/yyyy");
    var ciudadFecha = string.IsNullOrWhiteSpace(Model.Ciudad) ? fechaCreacion : $"{Model.Ciudad}, {fechaCreacion}";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Citación a Descargos N.º @Model.IdCitacion</title>
    <link rel="stylesheet" href="~/assets/css/citacion-descargos-documento.css" asp-append-version="true" />
</head>
<body>
    <div class="toolbar">
        <button type="button" class="btn" onclick="window.print()">Imprimir / Guardar como PDF</button>
        <a class="btn secondary" href="@Url.Action("Details", "CitacionDescargas", new { id = Model.IdCitacion })">Volver al detalle</a>
        <a class="btn secondary" href="@Url.Action("Index", "CitacionDescargas")">Listado</a>
    </div>

    <main class="page">
        <table class="header-table">
            <tr>
                <td class="logo-cell">
                    <img src="~/assets/images/logo-conflicto-interes.png" alt="Logo" class="logo" asp-append-version="true" />
                </td>
                <td class="title-cell">
                    <div class="company">MOUNTAIN ROSES SAS</div>
                    <div class="title">CITACIÓN A DESCARGOS</div>
                </td>
                <td class="meta-cell">
                    <div><strong>Consecutivo</strong> @Model.IdCitacion</div>
                    <div><strong>Fecha</strong> @(string.IsNullOrWhiteSpace(fechaCreacion) ? "—" : fechaCreacion)</div>
                </td>
            </tr>
        </table>

        <table class="form-table">
            <tr>
                <th class="label">Ciudad y fecha</th>
                <td class="value" colspan="3">@ciudadFecha</td>
            </tr>
            <tr>
                <th class="label">Nombre del trabajador</th>
                <td class="value" colspan="3">@Model.NomTrabajador</td>
            </tr>
            <tr>
                <th class="label">Cargo</th>
                <td class="value">@nombreCargo</td>
                <th class="label">Área o proceso</th>
                <td class="value">@nombreArea — @Model.Proceso</td>
            </tr>
            <tr>
                <th class="label">Asunto</th>
                <td class="value" colspan="3"><strong>Citación a diligencia de descargos</strong></td>
            </tr>
        </table>

        <div class="body-box">
            <p>
                Por medio de la presente nos permitimos citarlo el día
                <strong>@(fechaDiligencia ?? "________________")</strong>
                a las <strong>@(horaDiligencia ?? "________")</strong>
                a la Oficina de la Dirección de Gestión Humana con el fin de oír sus descargos sobre los hechos ocurridos el día
                <strong>@(fechaHechos ?? "________________")</strong>.
            </p>
            <p>
                En caso de que no se presente a la diligencia, la empresa entenderá que renuncia a su derecho de contradicción y defensa.
            </p>
        </div>

        <table class="sign-table">
            <tr>
                <td class="sign-col">
                    <div class="sign-label">Atentamente,</div>
                    <div class="sign-space">
                        @if (!string.IsNullOrWhiteSpace(Model.Owner))
                        {
                            <span>@Model.Owner</span>
                        }
                    </div>
                    <div class="sign-line"></div>
                    <div class="sign-caption">Dirección de Gestión Humana</div>
                </td>
                <td class="sign-col">
                    <div class="sign-label">Recibí:</div>
                    <div class="sign-space"></div>
                    <div class="sign-line"></div>
                    <div class="sign-caption">Firma del trabajador</div>
                    <div class="sign-cc">CC No. <strong>@Model.CcRecibido</strong></div>
                </td>
            </tr>
        </table>

        <div class="footer">Generado desde FloresMvc — @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</div>
    </main>
</body>
</html>
