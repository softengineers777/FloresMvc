@model FloresMvc.Models.CitacionDescargos
@{
    Layout = null;
    var nombreCargo = ViewBag.NombreCargo as string ?? Model.IdCargo.ToString();
    var nombreArea = ViewBag.NombreArea as string ?? Model.IdArea.ToString();
    var fechaDiligencia = Model.fecha_Diligencia?.ToString("dd/MM/yyyy");
    var horaDiligencia = Model.HoraDiligencia?.ToString("HH:mm");
    var fechaHechos = Model.FechaHechos?.ToString("dd/MM/yyyy");
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Citación a Descargos N.º @Model.IdCitacion</title>
    <link rel="stylesheet" href="~/assets/css/citacion-descargos-documento.css" asp-append-version="true" />
</head>
<body>
    <div class="toolbar">
        <button type="button" class="btn" onclick="window.print()">
            Imprimir / Guardar como PDF
        </button>
        <a class="btn secondary" href="@Url.Action("Details", "CitacionDescargas", new { id = Model.IdCitacion })">Volver al detalle</a>
        <a class="btn secondary" href="@Url.Action("Index", "CitacionDescargas")">Listado</a>
    </div>

    <main class="page">
        <h1>Citación a Descargos</h1>
        <p class="subtitle">Gestión Humana — Registro N.º @Model.IdCitacion</p>

        <div class="meta">
            <div><span class="label">Ciudad</span><div class="value">@(string.IsNullOrWhiteSpace(Model.Ciudad) ? "—" : Model.Ciudad)</div></div>
            <div><span class="label">Fecha de creación</span><div class="value">@(Model.fecha_Creacion == default ? "—" : Model.fecha_Creacion.ToString("dd/MM/yyyy HH:mm"))</div></div>
        </div>

        <section class="box">
            <h2>Datos del trabajador</h2>
            <div class="grid">
                <div class="field full">
                    <span class="label">Nombre del trabajador</span>
                    <div class="value">@Model.NomTrabajador</div>
                </div>
                <div class="field">
                    <span class="label">Cargo</span>
                    <div class="value">@nombreCargo</div>
                </div>
                <div class="field">
                    <span class="label">Área</span>
                    <div class="value">@nombreArea</div>
                </div>
                <div class="field">
                    <span class="label">Proceso</span>
                    <div class="value">@Model.Proceso</div>
                </div>
                <div class="field">
                    <span class="label">C.C. Recibido</span>
                    <div class="value">@Model.CcRecibido</div>
                </div>
            </div>
        </section>

        <section class="box">
            <h2>Información de la diligencia</h2>
            <div class="grid">
                <div class="field">
                    <span class="label">Fecha de diligencia</span>
                    <div class="value">@(fechaDiligencia ?? "—")</div>
                </div>
                <div class="field">
                    <span class="label">Hora de diligencia</span>
                    <div class="value">@(horaDiligencia ?? "—")</div>
                </div>
                <div class="field full">
                    <span class="label">Fecha de los hechos</span>
                    <div class="value">@(fechaHechos ?? "—")</div>
                </div>
            </div>
            <p class="body-text">
                Por medio del presente documento se cita al trabajador para que rinda sus descargos
                relacionados con los hechos indicados, en la fecha y hora señaladas para la diligencia.
                El trabajador podrá presentar las pruebas y explicaciones que considere pertinentes.
            </p>
        </section>

        <div class="signs">
            <div class="sign">
                <div class="sign-mark">@(string.IsNullOrWhiteSpace(Model.Owner) ? "" : Model.Owner)</div>
                <div class="sign-line"></div>
                <div class="sign-caption">Firma de quien cita</div>
            </div>
            <div class="sign">
                <div class="sign-mark">@Model.CcRecibido</div>
                <div class="sign-line"></div>
                <div class="sign-caption">Firma del trabajador / C.C. recibido</div>
            </div>
        </div>

        <div class="footer">Generado desde FloresMvc — @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</div>
    </main>
</body>
</html>
