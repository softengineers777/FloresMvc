@{
    Layout = null;
    var token = ViewBag.Token as string;
}
<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Restablecer Contraseña - FloresMvc</title>

    <meta name="description" content="Restablecer contraseña - FloresMvc">
    <link rel="icon" type="image/png" href="~/assets/images/favicon.ico">

    <link rel="stylesheet" href="~/assets/libs/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/assets/libs/bootstrap-icons/bootstrap-icons.css">
    <link rel="stylesheet" href="~/assets/css/main.css">
</head>

<body>

    <div class="login-wrapper">
        <div class="login-bg-shape login-bg-shape-1"></div>
        <div class="login-bg-shape login-bg-shape-2"></div>

        <div class="login-card">
            <a href="@Url.Action("Index", "Login")" class="login-brand text-decoration-none">
                <i class="bi bi-asterisk"></i>
                <span>Flores Vida</span>
            </a>

            <p class="login-subtitle">Define una nueva contraseña para tu cuenta.</p>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @ViewBag.Error
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (!string.IsNullOrEmpty(token))
            {
                <form asp-controller="Login" asp-action="ResetPassword" method="POST" class="needs-validation" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="token" value="@token" />

                    <div class="login-form-group">
                        <label for="passwordNueva" class="login-form-label">Nueva contraseña</label>
                        <div class="login-input-group">
                            <i class="bi bi-shield-lock input-icon"></i>
                            <input type="password" name="passwordNueva" id="passwordNueva" class="login-input login-input-password"
                                   placeholder="••••••••" minlength="6" autocomplete="new-password" required>
                        </div>
                        <div class="text-muted small mt-1">Mínimo 6 caracteres.</div>
                    </div>

                    <div class="login-form-group">
                        <label for="confirmarPassword" class="login-form-label">Confirmar nueva contraseña</label>
                        <div class="login-input-group">
                            <i class="bi bi-shield-check input-icon"></i>
                            <input type="password" name="confirmarPassword" id="confirmarPassword" class="login-input login-input-password"
                                   placeholder="••••••••" minlength="6" autocomplete="new-password" required>
                        </div>
                    </div>

                    <button type="submit" class="btn-login">
                        <span>Restablecer contraseña</span>
                        <i class="bi bi-check-lg"></i>
                    </button>
                </form>
            }
            else
            {
                <div class="text-center mt-3">
                    <a href="@Url.Action("ForgotPassword", "Login")" class="btn-login text-decoration-none justify-content-center">
                        <span>Solicitar un nuevo enlace</span>
                    </a>
                </div>
            }

            <div class="text-center mt-3">
                <a href="@Url.Action("Index", "Login")" class="forgot-password-link">
                    <i class="bi bi-arrow-left me-1"></i>Volver al inicio de sesión
                </a>
            </div>
        </div>
    </div>

    <script src="~/assets/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/js/auth.js"></script>
</body>

</html>
