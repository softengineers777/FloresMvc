<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - FloresMvc</title>

    <!-- SEO Optimization -->
    <meta name="description" content="FloresMvc Admin Dashboard">
    <meta name="author" content="FloresMvc Team">

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="~/assets/images/favicon.ico">

    <!-- Local Third-Party Libraries (Rutas corregidas con ~/) -->
    <link rel="stylesheet" href="~/assets/libs/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/assets/libs/bootstrap-icons/bootstrap-icons.css">
    <link rel="stylesheet" href="~/assets/libs/apexcharts/apexcharts.css">
    <link rel="stylesheet" href="~/assets/libs/flatpickr/flatpickr.min.css">

    <!-- Main Design System & Custom Stylesheet -->
    <link rel="stylesheet" href="~/assets/css/main.css">
</head>

<body>
    <!-- Contenedor principal del Dashboard (Estructura de Admin Template) -->
    <div class="app-wrapper">
        
        <!-- Sidebar de navegación -->
        @await Html.PartialAsync("_Sidebar")

        <!-- Contenedor de la derecha (Navbar + Contenido + Footer) -->
        <div class="app-content-wrapper">
            
            <!-- Navbar Superior -->
            @await Html.PartialAsync("_startNavbar")

            <!-- Contenido Dinámico de las Vistas (Aquí entra Usuarios/Index, Create, etc.) -->
            <main class="app-main p-4">
                <div class="container-fluid">
                    @RenderBody()
                </div>
            </main>

            <!-- Footer -->
            @await Html.PartialAsync("_startFooter")
            
        </div>
    </div>

    <!-- Scripts Javascript (Rutas corregidas con ~/) -->
    <script src="~/assets/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/libs/apexcharts/apexcharts.min.js"></script>
    <script src="~/assets/libs/flatpickr/flatpickr.min.js"></script>
    

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>