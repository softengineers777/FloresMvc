@using System.Security.Claims
@{
    var nombreSidebar = User.Identity?.Name ?? "Usuario";
    var emailSidebar = User.FindFirst(ClaimTypes.Email)?.Value ?? "";
    var controladorActual = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    bool EsControlador(string nombre) => string.Equals(controladorActual, nombre, StringComparison.OrdinalIgnoreCase);
   
    //***************Inicio Menu Administracion*****************************
    //Este Menu es  el administrador del  sistema tener contemplano el tema  de los permisos

    var enAdministracion = EsControlador("Roles") || EsControlador("Usuarios");
    var administracionExpandido = enAdministracion ? "true" : "false";
    var submenuAdministracionAbierto = enAdministracion ? "show" : "";
    var rolesActivo = EsControlador ("Roles") ? "active" : "";
    var usuariosActivo = EsControlador ("Usuarios") ? "active" : "";

    //Este Menu es  el administrador del  sistema tener contemplano el tema  de los permisos
    //***************Fin Menu Administracion*****************************


   //***************Inicio Menu Remisiones*****************************
    var enRemisiones = EsControlador("Remisiones");
    var mantenimientoExpandido = enRemisiones ? "true" : "false";
    var submenuMantenimientoAbierto = enRemisiones ? "show" : "";
    var remisionesActivo = enRemisiones ? "active" : "";
    //***************Fin Menu Remisiones*****************************

    //***************Inicio Menu Tablas Parametricas*****************************
    var enParametricas = EsControlador("Categorias") || EsControlador("SubCategorias")
        || EsControlador("Areas") || EsControlador("Fincas");
    var parametricasExpandido = enParametricas ? "true" : "false";
    var submenuParametricasAbierto = enParametricas ? "show" : "";
    var categoriasActivo = EsControlador("Categorias") ? "active" : "";
    var subCategoriasActivo = EsControlador("SubCategorias") ? "active" : "";
    var areasActivo = EsControlador("Areas") ? "active" : "";
    var fincasActivo = EsControlador("Fincas") ? "active" : "";
    //***************Fin Menu Tablas Parametricas*****************************

    //***************Inicio Menu Gestion Humana (GH)*****************************
    var enGestionH = EsControlador("ModeloDisciplinario") || EsControlador("CitacionDescargas") || EsControlador("ActaDescargos");
    var ghExpandido = enGestionH ? "true" : "false";
    var submenuGhAbierto = enGestionH ? "show" : "";
    var subModeloDisActivo = EsControlador("ModeloDisciplinario") ? "active" : "";
    var subCitActivo = EsControlador("CitacionDescargas") ? "active" : "";
    var subActaActivo = EsControlador("ActaDescargos") ? "active" : "";
    //***************Fin Menu Gestion Humana (GH)*****************************
}
<!-- ==========================================
         START: Sidebar Component
         Highly polished, dark-green sticky navigation
         ========================================== -->
<div class="sidebar-wrapper" id="sidebar">
    <!-- Brand Logo / Identity -->
    <a href="index.html" class="sidebar-brand">
        <i class="bi bi-asterisk"></i>
        <span>FloresVida</span>
    </a>

    <!-- Navigation Menu -->
    <div class="flex-grow-1 overflow-y-auto">
        <!-- Group: Menu -->
        <div class="sidebar-menu-section">
            <div class="sidebar-menu-title">Menu</div>
            <ul class="sidebar-menu-list">
                <li class="sidebar-menu-item">
                    <a href="index.html" class="sidebar-menu-link active" id="menu-overview" title="Overview">
                        <i class="bi bi-grid-fill"></i>
                        <span>Dashboard</span>
                    </a>
                </li>
            </ul>
        </div>

        <!-- Group: Components -->
        <div class="sidebar-menu-section">
            <div class="sidebar-menu-title">Components</div>
            <ul class="sidebar-menu-list">
                <li class="sidebar-menu-item">
                    <a class="sidebar-menu-link" data-bs-toggle="collapse" href="#submenu-administracion" role="button"
                       aria-expanded="@administracionExpandido" aria-controls="submenu-administracion"
                       title="Tablas Administracion">
                        <i class="bi bi-input-cursor-text"></i>
                        <span>Tablas Administracion</span>
                        <i class="bi bi-chevron-down dropdown-caret"></i>
                    </a>
                    <ul class="sidebar-submenu collapse @submenuAdministracionAbierto" id="submenu-administracion">
                        <li class="sidebar-menu-item">
                            <a href="/Roles/Index" class="sidebar-submenu-link @rolesActivo" id="menu-roles" title="Roles">
                                <i class="bi bi-input-cursor-text"></i>
                                <span>Roles</span>
                            </a>
                        </li>
                        <li class="sidebar-menu-item">
                            <a href="/Usuarios/Index" class="sidebar-submenu-link @usuariosActivo" id="menu-usuarios" title="Usuarios">
                                <i class="bi bi-table"></i>
                                <span>Usuarios</span>
                            </a>
                        </li>
                    </ul>
                </li>
                
               
                <li class="sidebar-menu-item">
                    <a class="sidebar-menu-link" data-bs-toggle="collapse" href="#submenu-parametricas" role="button"
                       aria-expanded="@parametricasExpandido" aria-controls="submenu-parametricas"
                       title="Tablas Paramétricas">
                        <i class="bi bi-grid-3x3-gap-fill"></i>
                        <span>Tablas Paramétricas</span>
                        <i class="bi bi-chevron-down dropdown-caret"></i>
                    </a>
                    <ul class="sidebar-submenu collapse @submenuParametricasAbierto" id="submenu-parametricas">
                        <li>
                            <a href="/Categorias/Index" class="sidebar-submenu-link @categoriasActivo"
                               id="menu-categorias" title="Categorías">
                                <i class="bi bi-tags-fill"></i>
                                <span>Categorías</span>
                            </a>
                        </li>
                        <li>
                            <a href="/SubCategorias/Index" class="sidebar-submenu-link @subCategoriasActivo"
                               id="menu-subcategorias" title="SubCategorías">
                                <i class="bi bi-diagram-3-fill"></i>
                                <span>SubCategorías</span>
                            </a>
                        </li>
                        <li>
                            <a href="/Areas/Index" class="sidebar-submenu-link @areasActivo" id="menu-areas"
                               title="Áreas">
                                <i class="bi bi-geo-alt-fill"></i>
                                <span>Áreas</span>
                            </a>
                        </li>
                        <li>
                            <a href="/Fincas/Index" class="sidebar-submenu-link @fincasActivo" id="menu-fincas"
                               title="Fincas">
                                <i class="bi bi-house-door-fill"></i>
                                <span>Fincas</span>
                            </a>
                        </li>AJR22J
                    </ul>
                </li>
                <li class="sidebar-menu-item">
                    <a class="sidebar-menu-link" data-bs-toggle="collapse" href="#submenu-mantenimiento" role="button"
                       aria-expanded="@mantenimientoExpandido" aria-controls="submenu-mantenimiento"
                       title="Mantenimiento">
                        <i class="bi bi-tools"></i>
                        <span>Mantenimiento Mountain</span>
                        <i class="bi bi-chevron-down dropdown-caret"></i>
                    </a>
                    <ul class="sidebar-submenu collapse @submenuMantenimientoAbierto" id="submenu-mantenimiento">
                        <li>
                            <a href="/Remisiones/Index" class="sidebar-submenu-link @remisionesActivo"
                               id="menu-remisiones" title="Remisiones">
                                <i class="bi bi-truck"></i>
                                <span>Remisiones</span>
                            </a>
                        </li>
                    </ul>
                </li>
                <li class="sidebar-menu-item">
                    <a class="sidebar-menu-link" data-bs-toggle="collapse" href="#submenu-gestion-humana" role="button"
                       aria-expanded="@ghExpandido" aria-controls="submenu-gestion-humana"
                       title="Gestión Humana">
                        <i class="bi bi-people-fill"></i>
                        <span>Gestión Humana</span>
                        <i class="bi bi-chevron-down dropdown-caret"></i>
                    </a>
                    <ul class="sidebar-submenu collapse @submenuGhAbierto" id="submenu-gestion-humana">
                        <li>
                            <a href="/ModeloDisciplinario/Index" class="sidebar-submenu-link @subModeloDisActivo"
                               id="menu-modelo-disciplinario" title="Modelo Disciplinario">
                                <i class="bi bi-journal-check"></i>
                                <span>Modelo Disciplinario</span>
                            </a>
                        </li>
                        <li>
                            <a href="/CitacionDescargas/Index" class="sidebar-submenu-link @subCitActivo"
                               id="menu-citacion-descargas" title="Citación Descargos">
                                <i class="bi bi-file-earmark-text"></i>
                                <span>Citación Descargos</span>
                            </a>
                        </li>
                        <li>
                            <a href="/ActaDescargos/Index" class="sidebar-submenu-link @subActaActivo"
                               id="menu-acta-descargos" title="Acta Descargos">
                                <i class="bi bi-file-earmark-check"></i>
                                <span>Acta Descargos</span>
                            </a>
                        </li>
                    </ul>
                </li>
                <li class="sidebar-menu-item">
                    <a href="ui-buttons.html" class="sidebar-menu-link" id="menu-uibuttons" title="Buttons">
                        <i class="bi bi-menu-button-wide-fill"></i>
                        <span>Buttons & Alerts</span>
                    </a>
                </li>
            </ul>
        </div>

        <!-- Group: Pages -->
        <div class="sidebar-menu-section">
            <div class="sidebar-menu-title">Pages</div>
            <ul class="sidebar-menu-list">
                <li class="sidebar-menu-item">
                    <a href="page-blank.html" class="sidebar-menu-link" id="menu-blankpage" title="Blank Page">
                        <i class="bi bi-file-earmark"></i>
                        <span>Blank Page</span>
                    </a>
                </li>
                <li class="sidebar-menu-item">
                    <a href="page-login.html" class="sidebar-menu-link" id="menu-loginpage" title="Login Page">
                        <i class="bi bi-box-arrow-in-right"></i>
                        <span>Login Screen</span>
                    </a>
                </li>
                <li class="sidebar-menu-item">
                    <a href="page-404.html" class="sidebar-menu-link" id="menu-404" title="404 Page">
                        <i class="bi bi-slash-circle"></i>
                        <span>Error 404</span>
                    </a>
                </li>
            </ul>
        </div>
    </div>

    <!-- Sidebar Profile Card (Dynamic Footer) -->
    <div class="sidebar-profile">
        <img src="~/assets/images/avatar.png" alt="Administrator" class="sidebar-profile-img" />
        <div class="sidebar-profile-info">
            <div class="sidebar-profile-name">@nombreSidebar</div>
            <div class="sidebar-profile-email">@emailSidebar</div>
        </div>
    </div>
</div>
<!-- ==========================================
         END: Sidebar Component
         ========================================== -->